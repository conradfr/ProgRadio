FROM hexpm/elixir:1.20.3-erlang-29.0.5-ubuntu-jammy-20260627
#FROM elixir:latest

ARG TZ=Europe/Paris
ARG DEBIAN_FRONTEND=noninteractive

ENV TZ=Europe/Paris
ENV DEBIAN_FRONTEND=noninteractive

EXPOSE 4000
EXPOSE 4001

RUN apt-get update && apt-get install --no-install-suggests -y \
    tzdata \
    build-essential make \
    imagemagick \
    pkgconf \
    libicu-dev \
    jpegoptim optipng pngquant gifsicle

# For temp forked dep
RUN apt-get install --no-install-recommends --no-install-suggests -y git ca-certificates
#
#RUN pkg-config --libs icu-uc icu-io

# Install hex package manager
RUN mix local.hex --force

RUN mkdir -p /app/progradio_api
COPY ./progradio_api /app/progradio_api/

WORKDIR /app/progradio_api

# Install dependencies.
# GitHub rate-limits unauthenticated clones, which breaks the forked git deps in
# mix.exs. Unlike the deploy image (built by CapRover's classic builder, where a
# build arg is the only option), local builds go through BuildKit, so the token
# is passed as a secret and never lands in a layer.
# The repos are public: a token with NO scopes at all is enough.
RUN --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
      export GIT_CONFIG_COUNT=1 \
             GIT_CONFIG_KEY_0="url.https://x-access-token:$(cat /run/secrets/github_token)@github.com/.insteadOf" \
             GIT_CONFIG_VALUE_0="https://github.com/"; \
    fi; \
    mix deps.get

# Compile the project
RUN mix do compile

# CMD ["mix", "phx.server"]

ENTRYPOINT ["tail", "-f", "/dev/null"]
