{# Shared stream macros, for both Stream entities and the array results of StreamRepository #}

{% macro picture(stream) -%}
  {#- entities have internalUseImg, repository arrays internal_use_img (and img_alt instead of ownLogo/radio) -#}
  {%- set internal_img = (stream.internalUseImg is defined and stream.internalUseImg == true)
    or (stream.internal_use_img is defined and stream.internal_use_img == true) -%}
  {%- if internal_img and stream.img is not null -%}
    media/stream/{{ stream.img }}
  {%- elseif stream.ownLogo is defined and stream.ownLogo == true and stream.radioStreamCodeName is not null -%}
    img/radio/page/{{ stream.radioStreamCodeName }}.png
  {%- elseif stream.radio is defined and stream.radio is not null -%}
    img/radio/page/{{ stream.radio.codeName }}.png
  {%- elseif stream.img_alt is defined and stream.img_alt is not null -%}
    img/radio/page/{{ stream.img_alt }}.png
  {%- elseif stream.img is not null and stream.img != '' -%}
    media/stream/{{ stream.img }}
  {%- else -%}
    img/stream-placeholder.png
  {%- endif -%}
{%- endmacro %}

{% macro topic(stream) %}song_next:{{ stream.id }}{% endmacro %}

{% macro radioOrStreamId(stream) -%}
  {%- if stream.radio is defined and stream.radio is not null -%}{{ stream.radio.codeName }}{%- else -%}{{ stream.id }}{%- endif -%}
{%- endmacro %}

{% macro domain(url) -%}
  {#- strip scheme, path/query/fragment, credentials, port and leading www. -#}
  {%- set host = url|default('')|trim|split('://')|last|trim('/', 'left')|split('/')|first|split('?')|first|split('#')|first|split('@')|last|split(':')|first|lower -%}
  {{- host starts with 'www.' ? host|slice(4) : host -}}
{%- endmacro %}
