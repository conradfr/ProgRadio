{% extends 'base_site.html.twig' %}

{% import _self as self %}

{% macro picture(stream) %}{%- if stream.internalUseImg is defined and stream.internalUseImg == true and stream.img is not null -%}
  media/stream/{{ stream.img }}
{%- elseif stream.ownLogo is defined and stream.ownLogo == true and stream.radioStreamCodeName is not null -%}
  img/radio/page/{{ stream.radioStreamCodeName }}.png
{%- elseif stream.radio is defined and stream.radio is not null -%}
  img/radio/page/{{ stream.radio.codeName }}.png
{%- elseif stream.img_alt is defined and stream.img_alt is not null -%}
  img/radio/page/{{ stream.img_alt }}.png
{%- elseif stream.img is not null and stream.img != '' -%}
  media/stream/{{ stream.img }}
{%- else -%}
  img/stream-placeholder.png
{%- endif -%}{% endmacro %}

{% macro topic(stream) %}song_next:{{ stream.id }}{% endmacro %}

{% macro radioOrStreamId(stream) %}
  {% if stream.radio is defined and stream.radio is not null %}{{ stream.radio.codeName }}{% else %}{{ stream.id }}{% endif %}
{% endmacro %}

{% macro domain(url) %}
  {#- strip scheme, path/query/fragment, credentials, port and leading www. -#}
  {%- set host = url|default('')|trim|split('://')|last|trim('/', 'left')|split('/')|first|split('?')|first|split('#')|first|split('@')|last|split(':')|first|lower -%}
  {{- host starts with 'www.' ? host|slice(4) : host -}}
{% endmacro %}

{% macro languages(languages) %}
  {#- two letter entries are iso 639-1 codes and get expanded, anything else is kept as is -#}
  {{- languages|split(',')
  |map(language => language|trim)
  |filter(language => language != '')
  |map(language => language|length == 2 ? language|language_name(language) : language)
  |join(', ') -}}
{% endmacro %}

{% macro title(stream) %}
  {% if stream.countryCode is not null and stream.countryCode != '' %}{{ 'page.stream.title_country'|trans({'%radio%': stream.name, '%country%': stream.getCountry(app.request.locale)}) }}{% else %}{{ 'page.stream.title'|trans({'%radio%': stream.name}) }}{% endif %}{% if stream.slogan is defined and stream.slogan is not null and stream.slogan != '' %} - {{ stream.slogan }}{% endif %}
{% endmacro %}

{% macro extractYouTubeIdAndProvideiFrame(url) %}
  {% set youtube_id = url | replace({
    'https://youtu.be/': '',
    'https://www.youtube.com/live/': '',
    'https://www.youtube.com/watch?v=': ''
  }) | split('?') | first %}
  <iframe width="325" height="183" src="https://www.youtube.com/embed/{{ youtube_id }}" title="YouTube video player" frameborder="0"
          sandbox="allow-forms allow-pointer-lock allow-same-origin allow-scripts allow-top-navigation allow-presentation"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
{% endmacro %}

{% macro extractDailymotionIdAndProvideiFrame(url) %}
  {% set dailymotion_id = url | replace({
    'https://www.dailymotion.com/video/': '',
  }) | split('?') | first %}
  <iframe frameborder="0" width="325" height="183"
          src="https://geo.dailymotion.com/player/x3d09.html?video={{ dailymotion_id }}"
          allowfullscreen
          allow="autoplay; fullscreen; picture-in-picture; web-share">
  </iframe>
{% endmacro %}

{% block head_supp %}
  {{ parent() }}
  <meta property="al:web:url" content="{{ absolute_url(path(app.current_route, app.current_route_parameters)) }}" />
  <meta property="og:title" content="{{ 'page.stream.title'|trans({'%radio%': stream.name}) }}">
  <meta property="og:url" content="{{ absolute_url(path(app.current_route, app.current_route_parameters)) }}">
  <meta property="og:type" content="music.radio_station">
  <meta property="og:site_name" content="{{ domainNameRequest }}">
  <meta property="og:image" content="{{ asset(self.picture(stream)) }}">
  <meta property="og:image:secure_url" content="{{ asset(self.picture(stream)) }}">
  <meta property="og:description" content="{{ 'page.stream.description'|trans({'%radio%': stream.name}) }}">
  <meta name="thumbnail" content="{{ asset(self.picture(stream)) }}">
  {% if stream.updatedAt is defined and stream.updatedAt is not null %}
    <meta property="og:updated_time" content="{{ stream.updatedAt|date('Y-m-d\\TH:i:sP') }}" />
    <meta property="article:modified_time" content="{{ stream.updatedAt|date('Y-m-d\\TH:i:sP') }}" />
  {% endif %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {% include('_partials/mini_player.html.twig') %}
  {#    {% if app.request.locale != 'fr' %}#}
  {%  if stream.noAds != true %}
    {{ include('_partials/adsense.html.twig') }}
  {% endif %}
  {#    {% endif %}#}

  <script type="application/javascript">
    {# todo: move to own file if reused #}
    const shareButton = document.querySelector('.share-button');

    shareButton.addEventListener('click', event => {
      if (navigator.share) {
        navigator.share({
          title: '{{ 'page.stream.title'|trans({'%radio%': stream.name}) }}',
          url: '{{ path('streams_one_short', {'shortId': stream.id|shortid, 'codename': stream.name|slug }) }}'
        }).then(() => {
          // console.log('Thanks for sharing!');
        })
          .catch(console.error);
      } else {
        // fallback
      }
    });

    const shareEmbed = document.querySelector('.share-embed');

    if (shareEmbed !== null) {
      const selectShareEmbed = () => shareEmbed.select();

      shareEmbed.addEventListener('focus', selectShareEmbed);
      shareEmbed.addEventListener('click', selectShareEmbed);
    }

    // song history times are rendered in server timezone, display them in the visitor's one (same as spa formatTime)
    const songHistoryTimeFormat = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    document.querySelectorAll('.song-history-time').forEach((el) => {
      const date = new Date(el.getAttribute('datetime'));
      if (!isNaN(date)) {
        el.textContent = songHistoryTimeFormat.format(date);
      }
    });
  </script>
{% endblock %}

{% block bodyclasssupp %} body-app{% endblock %}

{% block title %}
  {{ self.title(stream) }}
{% endblock %}

{% block description %}{{ 'page.stream.description'|trans({'%radio%': stream.name}) }}{% endblock %}

{% block body %}
  <div class="container stream-page stream-title stream-next" data-title="{{ self.title(stream) }}">
    <div class="row">
      <div class="col-12 col-sm-9">

        <!-- TOP LOGO & PLAYER -->
{#        <div class="d-sm-none text-center mt-2">#}
{#          <img class="radio-page-logo" alt="{{ stream.name }}" src="{{ preload(asset(self.picture(stream)), {as: 'image'}) }}">#}
{#        </div>#}

        <div class="stream-block d-flex mt-2 mt-sm-3 mb-2 mb-sm-3 p-3 pt-2 pt-sm-3 rounded border">
          <div class="d-none d-sm-block me-4">
            <img class="radio-page-logo" alt="{{ stream.name }}" src="{{ preload(asset(self.picture(stream)), {as: 'image'}) }}">

            <div class="mt-3 text-center" v-if="listeners !== null" v-scope v-cloak>
              <span class="d-none d-sm-inline">{{ 'page.stream.listeners'|trans }}:&nbsp;&nbsp;</span>
              {% verbatim %}
              <i v-if="listeners === 1" class="bi bi-person-fill"></i>
              <i v-if="listeners > 1" class="bi bi-people-fill"></i>
              {{ listeners }}
            {% endverbatim %}
            </div>
          </div>
          <div class="flex-grow-1">
            <div class="d-none d-sm-block float-end text-end">
              {% if is_granted('ROLE_ADMIN') %}
                <a target="_blank" href="{{ path('admin_overloading', {streamId: stream.id}) }}">
                  <i class="bi bi-pencil-square"></i>
                  {{ 'admin.stream_errors.edit'|trans }}
                </a>
              {% else %}
                <span class="d-none d-sm-block">
                <a target="_blank" class="link-no-to-bold" href="{{ path('streams_suggestion', {id: stream.id}) }}">{{ 'page.stream.modification.suggest'|trans }}</a>
              </span>
              {% endif %}
            </div>

            <div class="text-center text-sm-start">
              <div class="d-sm-none text-center">
                <img class="radio-page-logo mb-3" alt="{{ stream.name }}" src="{{ preload(asset(self.picture(stream)), {as: 'image'}) }}">
              </div>
              <h1 class="fw-bold mb-1 mb-sm-2 mb-sm-0">{{ stream.name }}</h1>
            </div>
            {% if stream.slogan is defined and stream.slogan is not null and stream.slogan != '' %}
              <div class="d-none d-sm-block text-truncate text-center text-sm-start mb-1">
                {{ stream.slogan }}
              </div>
            {% endif %}
            <div class="stream-one-tags d-flex align-items-center justify-content-center justify-content-sm-start mb-3 mb-sm4">
              {% if stream.countryCode is not null and stream.countryCode != '' %}
                <a href="{{ path('streaming_spa') }}/{{ stream.countryCode|lower }}">
                 <span class="badge badge-inverse badge-link my-0 flags-container">
                  <img class="gb-flag gb-flag--micro gb-flag--micro-ultra" src="{{ asset('img/flags/' ~ stream.countryCode|lower ~ '.svg') }}" alt="flag" />&nbsp;&nbsp;{{ stream.getCountry(app.request.locale) }}
                </span>
                </a>
              {% endif %}

              {% if stream.website is defined and stream.website is not null %}
                <a target="_blank" rel="nofollow" href="{{ stream.website }}">
                <span class="badge badge-inverse badge-link">
                  <i class="bi bi-globe"></i>&nbsp;&nbsp;{{ self.domain(stream.website) }}
                </span>
                </a>
              {% endif %}
            </div>

            {% if stream.playingError >= constant('App\\Entity\\Stream::ERROR_DISPLAY_THRESHOLD')  %}
              <div class="mb-3">
                <p class="text-warning text-center text-md-start mb-0">
                  <i class="bi bi-exclamation-circle"></i>&nbsp;&nbsp;{{ 'page.stream.errors'|trans }}
                </p>
                <small class="d-none d-sm-block text-muted">{{ 'sponsor.short'|trans({'%name%': stream.name, '%url%': stream.streamUrl|url_encode})|raw }}</small>
              </div>
            {% endif %}

            <div class="stream-page-stream" v-scope>
              <div class="d-flex align-items-center justify-content-between">
                <div class="d-sm-none" style="width: 50px">&nbsp;</div>

                <div>
                  {% if stream.banned == true %}
                    <div class="alert alert-danger">{{ 'page.stream.banned'|trans }}</div>
                  {% elseif 'youtu.be' in stream.streamUrl or 'youtube.com' in stream.streamUrl %}
                    {{ self.extractYouTubeIdAndProvideiFrame(stream.streamUrl) }}
                  {% elseif 'dailymotion' in stream.streamUrl %}
                    {{ self.extractDailymotionIdAndProvideiFrame(stream.streamUrl) }}
                  {% else %}
                    <div class="radio-page-streams-one mb-1 mb-sm-2 d-flex align-items-center justify-content-center justify-content-sm-start"
                         style="min-height: 45px" @vue:mounted="$el.classList.remove('d-none'); init({ topic: '{{- self.topic(stream) -}}', radioOrStreamId: '{{- self.radioOrStreamId(stream) -}}', historyUrl: '{{- url('song_history', {'_locale': app.request.locale, 'stream': stream.id}) -}}'  })">
                      <div v-cloak>
                        <div
                          v-if="playing === PLAYER_STATE_STOPPED"
                          @click="play('{{- stream.streamUrl -}}', '{{- stream.id -}}', {popup: {{- stream.popup ? 'true' : 'false' -}}, force_hls: {{- stream.forceHls ? 'true' : 'false' -}}, force_mpd: {{- stream.forceMpd ? 'true' : 'false' -}}, force_proxy: {{- stream.forceProxy ? 'true' : 'false' -}}, topic: '{{- self.topic(stream) -}}', radioOrStreamId: '{{- self.radioOrStreamId(stream) -}}', source: '{{- stream.source -}}'})"
                          class="radio-page-play">
                          <img alt="{{ 'page.stream.play'|trans({'%radio%': stream.name}) }}"
                               src="{{ asset('img/play-button-inside-a-circle.svg') }}">
                        </div>
                        <div
                          v-if="playing === PLAYER_STATE_PLAYING"
                          @click="stop('{{ stream.id }}')"
                          class="radio-page-play">
                          <img alt="{{ 'page.stream.stop'|trans({'%radio%': stream.name}) }}"
                               src="{{ asset('img/rounded-pause-button.svg') }}">
                        </div>
                        <div
                          v-if="playing === PLAYER_STATE_LOADING"
                          @click="stop('{{ stream.id }}')"
                          class="radio-page-play"
                          style="margin-right: 7px; margin-bottom: 2px;">
                          <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status"
                               title="{{ 'page.stream.stop'|trans({'%radio%': stream.name}) }}">
                            <span class="visually-hidden">Loading...</span>
                          </div>
                        </div>
                      </div>
                      <div class="ps-2" v-cloak>
                        <div
                          v-if="playing === PLAYER_STATE_STOPPED"
                          @click="play('{{- stream.streamUrl -}}', '{{- stream.id -}}', {popup: {{- stream.popup ? 'true' : 'false' -}}, force_hls: {{- stream.forceHls ? 'true' : 'false' -}}, force_mpd: {{- stream.forceMpd ? 'true' : 'false' -}}, force_proxy: {{- stream.forceProxy ? 'true' : 'false' -}}, topic: '{{- self.topic(stream) -}}', radioOrStreamId: '{{- self.radioOrStreamId(stream) -}}', source: '{{- stream.source -}}'})"
                          class="radio-page-play">
                          <div class="fs-2">&nbsp;{{ 'page.stream.play'|trans({'%radio%': stream.name}) }}</div>
                        </div>
                        <div
                          v-if="playing !== PLAYER_STATE_STOPPED"
                          @click="stop('{{ stream.id }}')"
                          class="radio-page-play">
                          <div class="fs-2">&nbsp;{{ 'page.stream.stop'|trans({'%radio%': stream.name}) }}</div>
                        </div>
                        <div id="volume-slider-wrapper" class="d-none d-sm-block ps-3 pt-2">
                          <div id="volume-slider"></div>
                        </div>
                      </div>
                    </div>
                  {% endif %}

                  {% if stream.popup == true %}
                    <div class="text-info mt-3"><small><i class="bi bi-info-circle"></i>&nbsp;&nbsp;{{ 'page.stream.popup'|trans }}</small></div>
                  {% endif %}

                  <div id="playing-alert" class="alert alert-danger d-none mt-3 mb-0" role="alert">
                    <i class="bi bi-x-circle"></i>&nbsp;&nbsp;{{ 'page.stream.playing_error'|trans }}
                  </div>
                </div>

                <div class="d-sm-none text-end" style="width: 50px" v-scope v-cloak>
                  {% verbatim %}
                    <i v-if="listeners === 1" class="bi bi-person-fill"></i>
                    <i v-if="listeners > 1" class="bi bi-people-fill"></i>
                    {{ listeners }}
                  {% endverbatim %}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- LIVE SONG -->

        <div class="stream-block mb-2 mb-sm-3 p-3 rounded border" v-if="song !== null" v-scope v-cloak>
          <div class="d-flex align-items-stretch">
            <div  class="me-3 live-song-cover text-start">
              <img class="mx-auto" :src="cover || '/img/stream-placeholder.png'">
            </div>
            <div class="d-flex flex-column justify-content-between pt-2 pb-0">
              <div class="d-none d-sm-inline-flex align-items-center text-muted gap-2">
                <span class="live-song-dot"></span> Titre en cours
              </div>
              <div>
                {% verbatim %}<span class="note-title">♫</span>&nbsp;{{ song }}{% endverbatim %}
              </div>
              <div class="stream-page-live-search stream-one-tags mt-2 mt-sm-0" v-if="song !== undefined && song !== null && song.trim() !== ''">
                <div class="d-flex flex-wrap align-items-center">
                  <a class="link-no-to-bold" target="_blank" title="{{ 'page.stream.find_youtube'|trans }}"
                     :href="encodeURI(`https://www.youtube.com/results?search_query=${song}`)">
                  <span class="badge badge-inverse badge-link my-0">
                    <i class="bi bi-youtube"></i><span>&nbsp;&nbsp;YouTube</span>
                  </span>
                  </a>&nbsp;
                  <a class="link-no-to-bold" target="_blank" title="{{ 'page.stream.find_spotify'|trans }}"
                     :href="encodeURI(`https://open.spotify.com/search/${song}`)">
                  <span class="badge badge-inverse badge-link my-0">
                    <i class="bi bi-spotify"></i><span>&nbsp;&nbsp;Spotify</span>
                  </span>
                  </a>
                  <a class="link-no-to-bold" target="_blank" title="{{ 'page.stream.find_deezer'|trans }}"
                     :href="encodeURI(`https://www.deezer.com/search/${song}`)">
                  <span class="badge badge-inverse badge-link my-0">
                    <i class="bi bi-boombox"></i><span>&nbsp;&nbsp;Deezer</span>
                  </span>
                  </a>
                  <a class="link-no-to-bold" target="_blank" title="{{ 'page.stream.find_amazon'|trans }}"
                     :href="encodeURI(`https://www.amazon.com/gp/search?ie=UTF8&linkCode=ur2&index=digital-music&keywords=${song}`)">
                  <span class="badge badge-inverse badge-link my-0">
                    <i class="bi bi-amazon"></i><span>&nbsp;&nbsp;Amazon</span>
                  </span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div id="song-history">
            {{ include('default/song_history.html.twig') }}
          </div>
        </div>

        <!-- MOBILE ADS -->

        <div class="pb-2 px-1 d-block d-sm-none">
          {%  if stream.noAds != true %}
            {{ include('_partials/adblock.html.twig', {style: 'horizontal', class: 'd-block d-sm-none'}) }}
          {% endif %}
        </div>

        <!-- SCHEDULE -->

        {% if schedule is defined and schedule is not null  %}
          <div class="stream-block mb-2 mb-sm-3 p-3 rounded border">
            <h5 class="mt-0">{{ 'page.stream.schedule'|trans }}</h5>
            {{ include('default/components/schedule.html.twig') }}
            {{ include('default/components/schedule.html.twig') }}
          </div>
        {% endif %}

        <!-- INFO -->

        <div class="stream-block mb-2 mb-sm-3 p-3 rounded border">
          {% if stream.banned != true %}
            <p><strong>{{ 'page.stream.about'|trans }}</strong></p>

            {% if stream.slogan is defined and stream.slogan is not null and stream.slogan != '' %}
              <div class="d-sm-none mb-3">
                {{ stream.slogan }}
              </div>
            {% endif %}

            {% if stream.description is defined and stream.description is not null and stream.description != '' %}
              <div class="mb-3">
                {{ stream.description|nl2br }}
              </div>
            {% endif %}
          {% endif %}

          {% if (stream.tags is not null and stream.tags != '') or (stream.genres is not null and stream.genres != '') %}
            <div class="mb-3">
              <div class="stream-one-tags">
                <div class="d-flex flex-wrap align-items-center">
                  {#                                        <div class="me-2"><strong>{{ 'page.stream.tags'|trans }}:</strong></div>#}
                  {% for genre in stream.genres|split(',') %}
                    <a href="{{ path('streaming_spa') }}/all?s={{ genre }}">
                    <span class="badge badge-inverse badge-link">
                        <i class="bi bi-music-note"></i>&nbsp;&nbsp;{{ genre }}
                    </span>
                    </a>
                  {% endfor %}

                  {% for tag in stream.tags|split(',') %}
                    <a href="{{ path('streaming_spa') }}/all?s={{ tag }}">
                    <span class="badge badge-inverse badge-link">
                        #{{ tag }}
                    </span>
                    </a>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

          <div class="d-flex align-items-center border-top pt-4">
            <h6 class="me-2 mb-0 collapsed cursor-pointer" data-bs-toggle="collapse" data-bs-target="#streamDetails" aria-expanded="false" aria-controls="streamDetails">
              {{ 'page.stream.more_information'|trans }}
              <i class="bi bi-caret-right-fill toggle-icon"></i>
            </h6>
          </div>
          <div class="collapse mt-3" id="streamDetails">
            <dl class="info mb-0">
              {% if stream.countryCode is not null and stream.countryCode != '' %}
                <dt>{{ 'page.stream.country'|trans }}</dt>
                <dd class="flags-container"><a href="{{ path('streaming_spa') }}/{{ stream.countryCode|lower }}">{{ stream.getCountry(app.request.locale) }}</a>&nbsp;&nbsp;<img class="gb-flag gb-flag--micro" src="{{ asset('img/flags/' ~ stream.countryCode|lower ~ '.svg') }}" alt="flag" /></dd>
              {% endif %}

              {% if stream.website is defined and stream.website is not null %}
                <dt>{{ 'page.stream.website'|trans }}</dt>
                <dd><a target="_blank" rel="nofollow" href="{{ stream.website }}">{{ stream.website }}</a> ↗</dd>
              {% endif %}

              {% if stream.language is defined and stream.language is not null and stream.language != '' %}
                <dt>{{ 'page.stream.languages'|trans }}</dt>
                <dd>{{ self.languages(stream.language) }}</dd>
              {% endif %}

              {% if stream.updatedAt is defined and stream.updatedAt is not null %}
                <dt>{{ 'page.stream.updated'|trans }}</dt>
                <dd>{{ stream.updatedAt|format_datetime('short', 'short') }}</dd>
              {% endif %}
            </dl>
          </div>
        </div>

        <!-- MOBILE SHARE -->

        <div class="d-sm-none text-center">
          <div class="mt-4 mb-4"><a target="_blank" class="link-no-to-bold" href="{{ path('streams_suggestion', {id: stream.id}) }}">{{ 'page.stream.modification.suggest'|trans }}</a></div>

          <button type="button" class="btn btn-sm share-button mb-4">
            <i class="bi bi-share-fill"></i>&nbsp;&nbsp;{{ 'page.stream.share'|trans }}
          </button>
        </div>

        <!-- SUGGESTED -->

        <div class="more-streams stream-block rounded border mb-2 mb-sm-3 p-3">
          <div class="text-center mb-3">
            <h5>{{ 'page.stream.suggested'|trans }}</h5>
          </div>

          {% if stream.countryCode is not null and stream.countryCode != '' %}
            <div class="text-center my-3">
              <a href="{{ path('streaming_spa') }}/{{ stream.countryCode }}">{{ 'page.top.more'|trans({'%country%': stream.getCountry(app.request.locale)}) }}</a>
            </div>
          {% endif %}

          <div class="d-flex align-content-start justify-content-center flex-wrap streams mb-4">
            {% for entry in more_streams %}
              <div class="streams-one streams-one-more streams-one-play-hide {% if loop.last == true %}d-none{% endif %} d-sm-block">
                <a href="{{ path('streams_one_short', {'shortId': entry.code_name|shortid, 'codename': entry.name|slug}) }}">
                  <div class="streams-one-img m-auto" style="background-image: url('{{ asset(self.picture(entry)) }}')"></div>
                </a>

                <div class="streams-one-name" title="{{ entry.name }}">
                  <a class="streams-one-name-detail" href="{{ path('streams_one_short', {'shortId': entry.code_name|shortid, 'codename': entry.name|slug}) }}">{{ entry.name }}</a>
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="text-center mb-3">
            <a class="more-link" href="{{ path('streaming_spa') }}/{{ stream.countryCode|default('') }}">{{ 'page.stream.discover'|trans }}</a>
          </div>
        </div>

        <div class="mt-5">
          <div class="text-center mb-3"><h5>{{ 'page.stream.share'|trans }}</h5></div>
          <div class="mb-3 text-center">
            <a target="_blank" href="{{ absolute_url(path('streams_one_short', {'shortId': stream.id|shortid, 'codename': stream.name|slug})) }}">
              {% if isProgRadioRequest %}
                <img src="{{ preload(asset('img/progradio-share-logo.png'), {as: 'image'}) }}" />
              {% else %}
                <img src="{{ preload(asset('img/radio-addict-share-logo.png'), {as: 'image'}) }}" />
              {% endif %}
            </a>
          </div>
          <div class="text-center">
        <textarea class="share-embed" readonly style="margin: auto" rows="5" cols="40"><a target="_blank" href="{{ absolute_url(path('streams_one_short', {'shortId': stream.id|shortid, 'codename': stream.name|slug})) }}">
{% if isProgRadioRequest %}
  <img src="{{ preload(asset('img/progradio-share-logo.png'), {as: 'image'}) }}" />
{% else %}
  <img src="{{ preload(asset('img/radio-addict-share-logo.png'), {as: 'image'}) }}" />
{% endif %}
</a></textarea>
          </div>
        </div>

