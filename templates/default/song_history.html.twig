{% if song_history is defined and song_history is not empty %}
    <div class="mt-3">
        <div class="d-flex align-items-center">
            <h6 class="me-2 mb-0 collapsed cursor-pointer" data-bs-toggle="collapse" data-bs-target="#historyDetails" aria-expanded="false" aria-controls="historyDetails">
                {{ 'page.stream.history'|trans }}
                <i class="bi bi-caret-right-fill toggle-icon"></i>
            </h6>
        </div>
        <div class="collapse mt-3" id="historyDetails" v-pre>
            {% for entry in song_history %}
                {% set history_song = [entry.artist ?? null, entry.title ?? null]|filter(v => v is not empty)|join(' - ') %}
                {% if history_song is not empty %}
                    <div class="d-flex{% if loop.last == false%} mt-3{% endif %}">
                        <div class="me-3 history-song-cover">
                            <img src="{{ (entry.cover_url ?? null) ?: asset('img/stream-placeholder.png') }}" alt="" loading="lazy">
                        </div>
                        <div class="d-flex flex-column justify-content-center">
                            <div class="mb-1">
                                {% if entry.detected_at is defined and entry.detected_at is not empty %}
                                    <time class="text-muted song-history-time" datetime="{{ entry.detected_at }}">{{ entry.detected_at|date('H:i') }}</time>&nbsp;-
                                {% endif %}
                                {{ history_song }}
                            </div>
                            <div>
                                <a class="link-no-to-bold" target="_blank" title="{{ 'page.stream.find_youtube'|trans }}"
                                   href="https://www.youtube.com/results?search_query={{ history_song|url_encode }}">
                                  <span class="badge badge-inverse badge-link my-0">
                                    <i class="bi bi-youtube"></i><span>&nbsp;&nbsp;YouTube</span>
                                  </span>
                                </a>&nbsp;&nbsp;
                                <a class="link-no-to-bold" target="_blank" title="{{ 'page.stream.find_spotify'|trans }}"
                                   href="https://open.spotify.com/search/{{ history_song|url_encode }}">
                                  <span class="badge badge-inverse badge-link my-0">
                                    <i class="bi bi-spotify"></i><span>&nbsp;&nbsp;Spotify</span>
                                  </span>
                                </a>&nbsp;&nbsp;
                                <a class="link-no-to-bold" target="_blank" title="{{ 'page.stream.find_deezer'|trans }}"
                                   href="https://www.deezer.com/search/{{ history_song|url_encode }}">
                                  <span class="badge badge-inverse badge-link my-0">
                                    <i class="bi bi-boombox-fill"></i><span>&nbsp;&nbsp;Deezer</span>
                                  </span>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{% endif %}
