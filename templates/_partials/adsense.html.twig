{% set user_agent = app.request ? app.request.headers.get('User-Agent')|default('') : '' %}
{# no ads in ios app #}
{% if app.environment == 'prod' and 'Mobile/15E148 radioaddict' not in user_agent %}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense_key }}"
            crossorigin="anonymous"></script>
    <script type="text/javascript">(adsbygoogle=window.adsbygoogle||[]).pauseAdRequests=1;</script>
    <script type="text/javascript">
      window.addEventListener('load', () => {
        // ensure this loads as there is conflict w/ the responsive grid
        window.setTimeout(() => {
          // one push per empty slot, a hidden slot (mobile/desktop) throws and must not prevent the next one
          document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(() => {
            try {
              (adsbygoogle = window.adsbygoogle || []).push({});
            } catch (error) {
              console.warn(error);
            }
          });
        }, 2000);

        (adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds = 0;
        (adsbygoogle = window.adsbygoogle || []).pauseAdRequests = 0;
      })
    </script>
{% endif %}
