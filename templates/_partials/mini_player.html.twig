<audio id="videoplayer" playsinline="playsinline" style="display:none"></audio>
<script type="text/javascript">
  const PLAYER_STATE_STOPPED = 1;
  const PLAYER_STATE_PLAYING = 3;
  const PLAYER_STATE_LOADING = 42;

  const streamsProxy = '{{ streams_proxy }}';
  const streamsProxyKey = '{{ streamsProxyKey() }}';
</script>

{# built from spa/src/mini_player.ts as the "player" vite entry, served as a cached file instead of inline #}
{% if app.environment == 'dev' %}
  <script type="module" src="http://localhost:8000/build/src/mini_player.ts"></script>
{% endif %}

{% if app.environment == 'prod' %}
  {# link tags = modulepreload of the chunks imported by the player (ITunesApi...), sent as a Link header (preload: link-header) #}
  {{ vite_entry_link_tags('player') }}
  {{ vite_entry_script_tags('player') }}
{% endif %}
